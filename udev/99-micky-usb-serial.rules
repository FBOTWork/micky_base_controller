# 1. Chip CH340 (ttyUSB*)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", SYMLINK+="arduino_imu", MODE="0666"

# 2. Chip STMicroelectronics (ttyACM*)
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", SYMLINK+="base_controller", MODE="0666"

# 3. Hokuyo URG-Series (front lidar)
SUBSYSTEM=="tty", ATTRS{idVendor}=="15d1", ATTRS{idProduct}=="0000", SYMLINK+="hokuyo_%n", MODE="0666"
